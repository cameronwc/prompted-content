# Operator credentials — never committed
.env
.env.*

# Python
.venv/
__pycache__/
*.pyc

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl.backup
crash.log
crash.*.log
# tfvars may contain secrets; the committed ones here hold only non-secret
# values (bucket names, TTLs). Anything matching *.secret.tfvars stays out.
*.secret.tfvars
*.auto.tfvars.json

# Photo ingest: raw session exports and archived sources never enter git
inbox/
archive/

# macOS
.DS_Store

# Pinterest pipeline: rendered pins and CSV batches are rebuilt from the
# manifest; only state/pinterest_manifest.json is tracked.
dist/pins/
dist/pins_csv/

# Reels pipeline: rendered videos, frames and CSVs are rebuilt from the
# catalog; nothing under dist/reels/ is tracked.
dist/reels/

# UGC reaction video pipeline: rendered videos, frames and CSVs are rebuilt
# from the hook bank + source clips; nothing under dist/ugc*/ is tracked.
# Source clips themselves (dist/actions/, dist/reactions/) are also
# generated/gitignored -- they come from other tools (app-screen recordings,
# Zeely reaction generation), not from this repo.
dist/ugc*/
dist/actions/
dist/reactions/
